{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "74rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "base",
					"name": "Tausta",
					"color": "#f3f6f6"
				},
				{
					"slug": "surface",
					"name": "Pinta",
					"color": "#ffffff"
				},
				{
					"slug": "ink",
					"name": "Teksti",
					"color": "#0e2424"
				},
				{
					"slug": "muted",
					"name": "Himmeä teksti",
					"color": "#55665f"
				},
				{
					"slug": "line",
					"name": "Viiva",
					"color": "#d6e0de"
				},
				{
					"slug": "accent",
					"name": "Havunvihreä",
					"color": "#0b6b63"
				},
				{
					"slug": "accent-soft",
					"name": "Vaalea vihreä",
					"color": "#e0f0ee"
				},
				{
					"slug": "due",
					"name": "Eräpäivä",
					"color": "#b8641a"
				},
				{
					"slug": "due-soft",
					"name": "Vaalea eräpäivä",
					"color": "#f6eadf"
				},
				{
					"slug": "hero",
					"name": "Tumma pohja",
					"color": "#0e2526"
				},
				{
					"slug": "hero-ink",
					"name": "Teksti tummalla",
					"color": "#eef4f1"
				},
				{
					"slug": "hero-muted",
					"name": "Himmeä tummalla",
					"color": "#9fb4ac"
				},
				{
					"slug": "hero-accent",
					"name": "Kirkas vihreä",
					"color": "#14a99b"
				},
				{
					"slug": "logo",
					"name": "Logon turkoosi",
					"color": "#14a99b"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/schibsted-grotesk-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Pieni",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Normaali",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Suuri",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Erittäin suuri",
					"size": "1.625rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.625rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Otsikko",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "huge",
					"name": "Pääotsikko",
					"size": "3.5rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(3rem, 7vw, 5rem)"
				},
				{
					"slug": "70",
					"name": "XXL",
					"size": "clamp(4rem, 9vw, 7rem)"
				}
			]
		},
		"custom": {
			"radius": "6px",
			"gutter": "clamp(1rem, 4vw, 2rem)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.1rem",
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.1rem"
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.3rem",
						"right": "1.3rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"fontSize": "1rem",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "#0d7c72",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.25rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.2rem",
					"fontWeight": "500",
					"lineHeight": "1.45"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "0.95rem"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "800"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "500"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.8rem"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Ylätunniste",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Alatunniste",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Laskeutumissivu (sisältö koko leveydeltä)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "Leveä sivu ilman sivupalkkia",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-blank",
			"title": "Tyhjä (vain ylä- ja alatunniste)",
			"postTypes": [
				"page"
			]
		}
	]
}
