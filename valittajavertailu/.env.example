# Kopioi tiedostoksi .env ja täytä. Älä tallenna .env-tiedostoa versionhallintaan.

# Pakolliset tuotannossa
PUBLIC_URL=https://valittajavertailu.fi
ADMIN_TOKEN=vaihda-pitkaan-satunnaiseen-merkkijonoon
SESSION_SECRET=vaihda-pitkaan-satunnaiseen-merkkijonoon
NODE_ENV=production

# Tietokanta (ilman tätä käytetään JSON-tiedostoja data/-kansiossa)
# DATABASE_URL=postgres://kayttaja:salasana@host:5432/valittaja

# Sähköposti (Postmark). Ilman tätä viestit näkyvät vain ylläpidon Viestit-välilehdellä.
# POSTMARK_TOKEN=
MAIL_FROM=Välittäjävertailu <noreply@valittajavertailu.fi>
ADMIN_EMAIL=

# Tekstiviestit (46elks), valinnainen
# ELKS_USER=
# ELKS_PASSWORD=
SMS_FROM=Valittajat

# Pilottialueet pilkulla eroteltuna, * tai tyhjä = koko Suomi
# PILOT_REGIONS=Uusimaa,Pirkanmaa

# Palvelumaksu välittäjälle jokaisesta valinnasta (€, alv 0 %) ja alkamispäivä (tyhjä = heti)
SUCCESS_FEE_EUR=149
# FEE_START_DATE=2027-01-01T00:00:00Z

# YTJ-tarkistus rekisteröinnissä (off = pois)
# YTJ_LOOKUP=off
