{
    "name": "nordic/nordic-chat",
    "description": "Nordic Ikkunat & Ovet – tekoälychat (WordPress-lisäosa)",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^0.54",
        "nyholm/psr7": "^1.8",
        "php-http/curl-client": "^2.3"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
