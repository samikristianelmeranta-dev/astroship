---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  dark?: boolean;
  id?: string;
}
const { eyebrow, title, lead, align = "left", dark = false, id } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]} data-reveal>
  {eyebrow && <p class:list={["eyebrow", dark && "!text-brand-light"]}>{eyebrow}</p>}
  <h2 id={id} class:list={["mt-3 text-4xl font-bold sm:text-5xl", dark && "text-white"]}>
    <slot name="title">{title}</slot>
  </h2>
  {lead && <p class:list={["mt-5 text-lg", dark ? "text-white/70" : "text-muted"]}>{lead}</p>}
</div>
