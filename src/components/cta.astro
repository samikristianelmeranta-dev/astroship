---
import Link from "./ui/link.astro";
---

<div
  class="bg-brand-950 p-8 md:px-20 md:py-20 mt-24 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight font-bold">
    Pyydä ilmainen tarjous
  </h2>
  <p class="text-brand-200 mt-4 text-lg md:text-xl max-w-2xl">
    Kerro meille kohteestasi, niin autamme valitsemaan sopivat Skaala-ikkunat
    ja -ovet sekä hoidamme mittauksen, tilauksen ja asennuksen puolestasi.
  </p>
  <div class="flex flex-col sm:flex-row gap-3 mt-6">
    <Link href="/yhteystiedot" style="inverted">Pyydä tarjous</Link>
    <a
      href="tel:+358401234567"
      class="rounded-sm text-center transition px-5 py-2.5 border-2 border-brand-700 text-white hover:bg-brand-800">
      Soita 040 123 4567
    </a>
  </div>
</div>
