---
import { Icon } from "astro-icon/components";
import Link from "./ui/link.astro";
---

<div
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Pyydä ilmainen tarjous jo tänään.
  </h2>
  <p class="text-slate-400 mt-4 text-lg md:text-xl max-w-2xl">
    Mittakäynti ja tarjous ovat aina maksuttomia ja sitoumuksettomia. Vastaamme
    yleensä samana arkipäivänä.
  </p>
  <div class="flex flex-col sm:flex-row mt-5 gap-3">
    <Link
      href="/contact"
      style="inverted"
      class="flex gap-1 items-center justify-center">
      <Icon class="w-5 h-5" name="bx:bxs-phone-call" />
      Pyydä tarjous
    </Link>
    <a
      href="tel:+358401234567"
      class="flex gap-1 items-center justify-center text-white border-2 border-white/30 rounded-sm px-5 py-2.5 hover:bg-white/10 transition">
      040 123 4567
    </a>
  </div>
</div>
