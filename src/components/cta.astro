---
import Link from "./ui/link.astro";
---

<div
  class="bg-indigo-600 p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-white text-4xl md:text-6xl tracking-tight">
    Kasvata myyntiäsi tänään.
  </h2>
  <p class="text-indigo-200 mt-4 text-lg md:text-xl">
    Aloita ilmainen 14 päivän kokeilu — ilman sitoutumista. Näe konkreettiset tulokset ennen kuin maksat mitään.
  </p>
  <div class="flex mt-5">
    <Link href="/contact" style="inverted">Aloita ilmaiseksi</Link>
  </div>
</div>
