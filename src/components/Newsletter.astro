---
import { Icon } from "astro-icon/components";
import Container from "@/components/container.astro";
import { site } from "@/config/site";
---

<section id="uutiskirje" aria-labelledby="uutiskirje-title" class="py-24">
  <Container>
    <div
      class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand via-brand-dark to-ink px-8 py-16 text-white sm:px-16"
      data-reveal="zoom">
      <div class="pointer-events-none absolute -right-16 -top-16 size-72 rounded-full bg-white/10 blur-2xl animate-blob" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 left-1/3 size-80 rounded-full bg-brand-light/30 blur-3xl animate-blob blob-delay" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.5fr_1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/70">Sisäpiiri</p>
          <h2 id="uutiskirje-title" class="mt-3 text-4xl font-bold sm:text-5xl">Liity sisäpiiriin</h2>
          <p class="mt-4 max-w-xl text-lg text-white/80">
            Saat minulta 1–2 sähköpostia kuukaudessa yhteiskunnallisista asioista – selkeästi ja ilman poliittista
            jargonia. En roskapostita, enkä luovuta tietojasi eteenpäin.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
          <a href={site.newsletterUrl} target="_blank" rel="noopener noreferrer" class="btn bg-white text-ink hover:-translate-y-0.5 hover:shadow-2xl">
            <Icon name="lucide:mail-plus" class="size-5" aria-hidden="true" />
            Tilaa uutiskirje
          </a>
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
            Laita viestiä WhatsAppissa
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
