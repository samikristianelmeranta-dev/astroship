---
import { Icon } from "astro-icon/components";

const areas = [
  "Turku",
  "Kaarina",
  "Raisio",
  "Naantali",
  "Lieto",
  "Rusko",
  "Masku",
  "Paimio",
];
---

<div class="mt-20 bg-slate-50 rounded-2xl px-6 py-12 md:px-16 text-center">
  <Icon class="w-8 h-8 mx-auto text-black" name="bx:bxs-map" />
  <h2 class="text-3xl lg:text-4xl font-bold lg:tracking-tight mt-4">
    Palvelemme koko Turun seudulla
  </h2>
  <p class="text-lg mt-4 text-slate-600 max-w-xl mx-auto">
    Asennustiimimme liikkuu ketterästi Turun ja sen ympäryskuntien alueella.
  </p>
  <div class="flex flex-wrap gap-3 justify-center mt-6">
    {
      areas.map((area) => (
        <span class="bg-white border border-slate-200 rounded-full px-4 py-1.5 text-slate-700 font-medium">
          {area}
        </span>
      ))
    }
  </div>
</div>
