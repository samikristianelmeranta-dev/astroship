---
import Icon from "./Icon.astro";
export interface Props {
  title: string;
  lead: string;
  image: string;
  imageAlt: string;
  eyebrow?: string;
  portrait?: boolean;
  secondary?: { href: string; label: string };
}
const { title, lead, image, imageAlt, eyebrow, portrait = false, secondary } = Astro.props;
---
<section class="v4hero">
  <div class="wrap v4hero-wrap">
    <div class="v4hero-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      <p>{lead}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#tarjous" data-quote><span>Pyydä ilmainen tarjous</span><Icon name="arrow" /></a>
        {secondary && <a class="btn btn-outline-pine" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    <div class:list={["v4hero-media", { portrait }]}>
      <img src={image} alt={imageAlt} width="1200" height="800" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>
