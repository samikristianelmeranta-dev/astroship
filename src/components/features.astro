---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "AI-pohjainen mainonta",
    description:
      "Tekoäly optimoi mainoskampanjasi reaaliajassa — oikea viesti, oikealle henkilölle, oikeaan aikaan. Tulokset paranevat jatkuvasti.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Tulosperusteinen hinnoittelu",
    description:
      "Maksat vain todellisista tuloksista. Ei piilomaksuja, ei tyhjiin lupauksiin perustuvaa laskutusta — vain mitattavia kasvutuloksia.",
    icon: "bx:bxs-badge-check",
  },
  {
    title: "Konversio-optimointi",
    description:
      "Muunnamme sivustosi kävijät maksaviksi asiakkaiksi. A/B-testaus, laskeutumissivut ja käyttäjäpolun optimointi kasvattavat myyntiäsi.",
    icon: "bx:bxs-chart",
  },
  {
    title: "Hakukoneoptimointi (SEO)",
    description:
      "Nouse Googlen hakutuloksissa orgaanisesti. Tekninen SEO, sisältöstrategia ja linkkiprofiili — kaikki yhdestä paikasta.",
    icon: "bx:bxs-file-find",
  },
  {
    title: "Somemarkkinointi",
    description:
      "Meta, TikTok, LinkedIn — hallitsemme kanavat, joissa asiakkaasi ovat. Luovaa sisältöä ja kohdennettua mainontaa brändin kasvuun.",
    icon: "bx:bxl-instagram",
  },
  {
    title: "Reaaliaikainen analytiikka",
    description:
      "Näet tarkalleen, mitä rahasi tuottavat. Selkeät raportit ja dashboardit pitävät sinut aina tilanteen tasalla ilman teknistä osaamista.",
    icon: "bx:bxs-bar-chart-alt-2",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Kaikki mitä tarvitset kasvuun
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    TulosAgentti yhdistää tekoälyn, datan ja markkinointiosaamisen — niin että yrityksesi kasvaa nopeammin kuin koskaan.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-indigo-600 rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
