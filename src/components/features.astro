---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Kotimainen Skaala-laatu",
    description:
      "Myymme Skaalan Suomessa valmistamia ikkunoita ja ovia, jotka on suunniteltu kestämään pohjoismaiset sääolot vuosikymmenien ajan.",
    icon: "bx:bxs-factory",
  },
  {
    title: "Energiatehokkaat ratkaisut",
    description:
      "Autamme valitsemaan lämpöä pidättävät, matalan U-arvon ikkunat ja ovet, jotka pienentävät lämmityskuluja ja parantavat asumismukavuutta.",
    icon: "bx:bxs-leaf",
  },
  {
    title: "Mittatilaustyönä kotiisi",
    description:
      "Ikkunat ja ovet valmistetaan juuri sinun kotisi mittojen ja tyylin mukaan – uudisrakentamiseen tai peruskorjaukseen.",
    icon: "bx:bxs-ruler",
  },
  {
    title: "Ammattitaitoinen asennus",
    description:
      "Asennusryhmämme huolehtii tiiviistä ja turvallisesta asennuksesta alusta loppuun, jotta ikkunat ja ovet toimivat moitteetta.",
    icon: "bx:bxs-wrench",
  },
  {
    title: "Laaja väri- ja mallivalikoima",
    description:
      "Valitse Skaalan värivaihtoehdoista sisä- ja ulkopuolelle erikseen, ja yhdistä ikkunat ja ovet talosi tyyliin sopivaksi kokonaisuudeksi.",
    icon: "bx:bxs-palette",
  },
  {
    title: "Turvallisuus ja pitkä käyttöikä",
    description:
      "Laadukkaat helat, tiivisteet ja lasiratkaisut lisäävät kodin turvallisuutta ja varmistavat tuotteiden pitkän käyttöiän.",
    icon: "bx:bxs-shield",
  },
];
---

<div class="mt-16 md:mt-0" id="miksi-me">
  <h2 class="text-4xl lg:text-5xl font-bold text-brand-950 lg:tracking-tight">
    Miksi valita Suomen Ikkuna &amp; Ovi?
  </h2>
  <p class="text-lg mt-4 text-slate-600 max-w-2xl">
    Olemme Skaala-tuotteiden jälleenmyyjä, joka yhdistää kotimaisen
    valmistuksen laadun ja henkilökohtaisen, paikallisen palvelun. Näin
    projektisi etenee sujuvasti mittauksesta valmiiseen asennukseen.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-x-10 gap-y-14">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-brand-900 rounded-full p-2 w-9 h-9 shrink-0 flex items-center justify-center">
          <Icon class="text-white w-5 h-5" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg text-brand-950">{item.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
