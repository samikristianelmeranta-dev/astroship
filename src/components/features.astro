---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "SEO-optimointi",
    description:
      "Tekninen SEO, sisältöstrategia ja avainsana-analyysi, jotka nostavat sivustosi Googlen hakutuloksissa oikeilla hakusanoilla.",
    icon: "bx:bxs-search-alt-2",
  },
  {
    title: "AI-optimointi",
    description:
      "Varmistan, että yrityksesi löytyy myös ChatGPT:n, Perplexityn ja Google AI Overviews'n kaltaisista tekoälyhauista.",
    icon: "bx:bxs-brain",
  },
  {
    title: "Kotisivujen toteutus",
    description:
      "Nopeat, saavutettavat ja hakukoneystävälliset kotisivut, jotka on rakennettu muuntamaan kävijät asiakkaiksi.",
    icon: "bx:bxs-palette",
  },
  {
    title: "Digitaalinen markkinointi",
    description:
      "Google- ja somemainonta, sähköpostimarkkinointi ja sisällöntuotanto osana yhtenäistä kasvustrategiaa.",
    icon: "bx:bxs-megaphone",
  },
  {
    title: "Konversio-optimointi",
    description:
      "Sivuston ja laskeutumissivujen hienosäätöä, jotta nykyinen kävijämäärä muuttuu tehokkaammin liideiksi ja myynniksi.",
    icon: "bx:trending-up",
  },
  {
    title: "Analytiikka & raportointi",
    description:
      "Selkeät kuukausiraportit ja mittarit, joista näet suoraan mitä tehdään ja miten se näkyy tuloksissa.",
    icon: "bx:bxs-bar-chart-alt-2",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Kaikki kasvun palaset saman katon alta
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Yhdistän hakukonenäkyvyyden, tekoälyoptimoinnin ja markkinoinnin yhdeksi
    selkeäksi kokonaisuudeksi – ilman erillisiä toimistoja ja väliportaita.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-emerald-600 rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
