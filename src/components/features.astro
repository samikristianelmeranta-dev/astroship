---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Yli 20 vuoden kokemus",
    description:
      "Olemme asentaneet satoja ikkuna- ja oviremontteja Turun seudulla. Tunnemme alueen talotyypit ja rakennusmääräykset.",
    icon: "bx:bxs-medal",
  },
  {
    title: "Ilmainen mittaus ja tarjous",
    description:
      "Käymme paikan päällä mittaamassa ja teemme sitovan tarjouksen ilman kuluja tai velvoitteita.",
    icon: "bx:bxs-ruler",
  },
  {
    title: "Asennus avaimet käteen",
    description:
      "Oma, kokenut asennustiimimme hoitaa purun, asennuksen ja viimeistelyn — siivouksen unohtamatta.",
    icon: "bx:bxs-wrench",
  },
  {
    title: "Energiatehokkuus ja säästöt",
    description:
      "Nykyaikaiset ikkunat ja ovet pienentävät lämmityskuluja ja parantavat asumismukavuutta ympäri vuoden.",
    icon: "bx:bxs-leaf",
  },
  {
    title: "Takuu ja jälkihuolto",
    description:
      "Annamme tuotteille ja asennustyölle pitkän takuun. Palvelemme myös asennuksen jälkeen.",
    icon: "bx:bxs-shield-alt-2",
  },
  {
    title: "Paikallinen turkulainen tiimi",
    description:
      "Toimimme Turussa, Kaarinassa, Raisiossa, Naantalissa, Liedossa ja lähialueilla — nopeasti ja luotettavasti.",
    icon: "bx:bxs-map",
  },
];
---

<div id="miksi-me" class="mt-20 scroll-mt-24">
  <div class="text-center max-w-2xl mx-auto">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
      Miksi valita meidät
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Yhdeltä toimittajalta suunnittelu, tuotteet ja asennus — ilman
      välikäsiä.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
    {
      features.map((item) => (
        <div class="flex gap-4 items-start">
          <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
            <p class="text-slate-500 mt-2 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>
