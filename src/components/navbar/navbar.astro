---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Palvelut",
    path: "/palvelut",
  },
  {
    title: "Hinnoittelu",
    path: "/hinnoittelu",
  },
  {
    title: "Blogi",
    path: "/blogi",
  },
  {
    title: "Meistä",
    path: "/meista",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg flex items-center gap-2">
          <svg
            class="w-6 h-6"
            viewBox="0 0 36 36"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="20" width="5" height="10" rx="1.5" fill="#059669"
            ></rect>
            <rect x="15.5" y="14" width="5" height="16" rx="1.5" fill="#059669"
            ></rect>
            <rect x="25" y="7" width="5" height="23" rx="1.5" fill="#059669"
            ></rect>
            <path
              d="M6 15.5 15 8.5 20.5 12.5 30 4"
              stroke="#059669"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M23 4h7v7"
              stroke="#059669"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="font-bold text-slate-800">Kasvu</span><span
            class="text-emerald-600 font-bold">Kumppani</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                  <span>{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="/yhteystiedot" block size="md">Pyydä tarjous</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <Link href="/yhteystiedot" size="md">Pyydä tarjous</Link>
      </div>
    </div>
  </header>
</Container>
