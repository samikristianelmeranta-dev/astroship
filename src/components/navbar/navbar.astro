---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";

const menuitems = [
  {
    title: "Ikkunat",
    path: "/#ikkunat",
  },
  {
    title: "Ulko-ovet",
    path: "/#ulko-ovet",
  },
  {
    title: "Miksi me",
    path: "/#miksi-me",
  },
  {
    title: "Referenssit",
    path: "/#referenssit",
  },
  {
    title: "Yhteystiedot",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-lg flex items-center gap-1"
          ><span class="font-bold text-slate-800">Turun</span><span
            class="text-slate-500">Ikkuna&amp;Ovi</span
          >
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                  <span> {item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="/contact" block size="md">Pyydä tarjous</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-5">
        <a
          href="tel:+358401234567"
          class="flex items-center gap-2 text-gray-600 hover:text-gray-900">
          <Icon class="w-4 h-4 text-gray-400" name="bx:bxs-phone-call" />
          040 123 4567
        </a>
        <Link href="/contact" size="md">Pyydä tarjous</Link>
      </div>
    </div>
  </header>
</Container>
