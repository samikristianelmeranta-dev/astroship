---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from "astro-icon/components";

const menuitems = [
  {
    title: "Tuotteet",
    path: "#",
    children: [
      { title: "Ikkunat", path: "/ikkunat" },
      { title: "Ovet", path: "/ovet" },
    ],
  },
  {
    title: "Yritys",
    path: "/yritys",
  },
  {
    title: "Blogi",
    path: "/blogi",
  },
  {
    title: "UKK",
    path: "/ukk",
  },
  {
    title: "Yhteystiedot",
    path: "/yhteystiedot",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-lg" aria-label="Suomen Ikkuna & Ovi - etusivu">
          <span
            class="flex items-center justify-center w-9 h-9 rounded-md bg-brand-900 text-white shrink-0">
            <Icon name="uil:window" class="w-5 h-5" />
          </span>
          <span class="leading-tight">
            <span class="font-bold text-brand-900 block">Suomen Ikkuna &amp; Ovi</span>
            <span class="text-[11px] uppercase tracking-wide text-accent-600 font-semibold block -mt-0.5">Kotimaiset ikkunat ja ovet</span>
          </span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-brand-900" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-brand-800 hover:text-accent-600 font-medium">
                      <span> {item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="tel:+358401234567" style="muted" block size="md">Soita meille</Link>
          <Link href="/yhteystiedot" block size="md">Pyydä tarjous</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="tel:+358401234567"
          class="flex items-center gap-1.5 text-brand-800 hover:text-accent-600 font-medium">
          <Icon name="uil:phone" class="w-4 h-4" />
          040 123 4567
        </a>
        <Link href="/yhteystiedot" size="md">Pyydä tarjous</Link>
      </div>
    </div>
  </header>
</Container>
