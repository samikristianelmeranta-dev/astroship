---
import { site } from "@/data/site";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Haluatko, että olemme sinuun yhteydessä?",
  text = "Jätä yhteydenottopyyntö, niin palaamme asiaan mahdollisimman pian. Kysyminen ei velvoita sinua mihinkään.",
} = Astro.props;
---

<section class="cta-band">
  <div class="wrap cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href="/yhteystiedot/" class="btn btn-primary">Pyydä tarjous</a>
      <a href={site.phoneHref} class="btn btn-ghost">Soita {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--accent-soft);
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .cta-inner > div:first-child {
    max-width: 38rem;
    display: grid;
    gap: 0.6rem;
  }
  h2 {
    font-size: var(--step-2);
  }
  p {
    color: var(--muted);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-ghost {
    color: var(--ink);
  }
</style>
