---
// @ts-ignore
import { Icon } from "astro-icon/components";

const tools = [
  "simple-icons:google",
  "simple-icons:googleanalytics",
  "simple-icons:googlesearchconsole",
  "simple-icons:googletagmanager",
  "simple-icons:semrush",
  "simple-icons:wordpress",
  "simple-icons:hubspot",
  "simple-icons:openai",
];
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">
    Työkalut ja alustat, joita hyödynnän
  </h2>
  <div class="flex gap-8 md:gap-16 items-center justify-center mt-10 flex-wrap">
    {tools.map((name) => <Icon class="size-8 md:size-10 text-slate-700" name={name} />)}
  </div>
</div>
