---
import Button from "./ui/button.astro";
---

<!-- Lomake lähettää viestit Web3Forms-palvelun kautta. Luo oma ilmainen
     access key osoitteessa https://web3forms.com/ ja korvaa alla oleva
     placeholder-arvo, jotta lomake toimii tuotannossa. -->
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation"
  novalidate>
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
  <input type="hidden" name="subject" value="Uusi tarjouspyyntö - Suomen Ikkuna & Ovi" />
  <!-- Korvaa yllä oleva access_key omalla web3forms.com-avaimellasi -->
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <label for="name" class="sr-only">Koko nimi</label>
    <input
      id="name"
      type="text"
      placeholder="Koko nimi"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-brand-600 ring-brand-100"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Anna koko nimesi.
    </div>
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Sähköpostiosoite</label><input
      id="email_address"
      type="email"
      placeholder="Sähköpostiosoite"
      name="email"
      required
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-brand-600 ring-brand-100"
    />
    <div class="empty-feedback text-red-400 text-sm mt-1">
      Anna sähköpostiosoitteesi.
    </div>
    <div class="invalid-feedback text-red-400 text-sm mt-1">
      Anna kelvollinen sähköpostiosoite.
    </div>
  </div>
  <div class="mb-5">
    <label for="phone" class="sr-only">Puhelinnumero</label>
    <input
      id="phone"
      type="tel"
      placeholder="Puhelinnumero"
      name="phone"
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-brand-600 ring-brand-100"
    />
  </div>
  <div class="mb-3">
    <label for="message" class="sr-only">Viesti</label>
    <textarea
      id="message"
      name="message"
      required
      placeholder="Kerro kohteestasi: ikkunat/ovet, kappalemäärä, aikataulu..."
      class="w-full px-4 py-3 border-2 placeholder:text-gray-800 rounded-md outline-hidden h-36 focus:ring-4 border-gray-300 focus:border-brand-600 ring-brand-100"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
      Kirjoita viesti.
    </div>
  </div>
  <Button type="submit" size="lg" block>Lähetä tarjouspyyntö</Button>
  <div id="result" class="mt-3 text-center"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0].focus();
      return;
    }
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.innerHTML = "Lähetetään...";

    fetch("https://api.web3forms.com/submit", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json();
        if (response.status == 200) {
          result.classList.add("text-green-500");
          result.innerHTML = "Kiitos! Viestisi on lähetetty, otamme yhteyttä pian.";
        } else {
          console.log(response);
          result.classList.add("text-red-500");
          result.innerHTML = json.message;
        }
      })
      .catch((error) => {
        console.log(error);
        result.innerHTML = "Jokin meni pieleen. Yritä hetken kuluttua uudelleen.";
      })
      .then(function () {
        form.reset();
        form.classList.remove("was-validated");
        setTimeout(() => {
          result.style.display = "none";
        }, 5000);
      });
  });
</script>
