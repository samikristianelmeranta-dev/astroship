---
import { Icon } from "astro-icon/components";
import Container from "@/components/container.astro";
import { site } from "@/config/site";

const current = Astro.url.pathname;
const isActive = (path: string) => current === path || current.startsWith(path);
---

<header
  data-header
  class="group/header sticky top-0 z-50 transition-all duration-500 [&.is-scrolled]:bg-white/80 [&.is-scrolled]:shadow-sm [&.is-scrolled]:backdrop-blur-xl">
  <Container class="flex h-20 items-center justify-between gap-6 transition-all duration-500 group-[.is-scrolled]/header:h-16">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} – etusivu`}>
      <span
        class="grid size-10 place-items-center rounded-2xl bg-brand font-display text-lg font-extrabold text-white shadow-lg shadow-brand/30 transition duration-500 group-hover:rotate-[-8deg] group-hover:scale-105"
        aria-hidden="true">SE</span
      >
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold">{site.name}</span>
        <span class="block text-xs font-medium uppercase tracking-[0.2em] text-muted">{site.party.name}</span>
      </span>
    </a>

    <nav aria-label="Päävalikko" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={isActive(item.path) ? "page" : undefined}
                class="relative rounded-full px-4 py-2 font-medium text-ink/80 transition hover:text-ink aria-[current=page]:text-brand-dark after:absolute after:inset-x-4 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-brand after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100">
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/yhteys/" class="btn-primary hidden !px-5 !py-2.5 sm:inline-flex">
        Ota yhteyttä
        <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group grid size-11 place-items-center rounded-full ring-1 ring-line lg:hidden">
        <span class="sr-only">Avaa valikko</span>
        <Icon name="lucide:menu" class="size-5 group-aria-expanded:hidden" aria-hidden="true" />
        <Icon name="lucide:x" class="hidden size-5 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </Container>

  <div id="mobile-menu" hidden class="fixed inset-x-0 top-20 bottom-0 bg-white/95 backdrop-blur-xl lg:hidden">
    <nav aria-label="Mobiilivalikko" class="px-6 py-8">
      <ul class="space-y-1">
        {
          [...site.nav, { title: "Ota yhteyttä", path: "/yhteys/" }].map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={isActive(item.path) ? "page" : undefined}
                class="flex items-center justify-between border-b border-line py-4 font-display text-2xl font-bold aria-[current=page]:text-brand-dark">
                {item.title}
                <Icon name="lucide:arrow-right" class="size-5 text-brand" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
