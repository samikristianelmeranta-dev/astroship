---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Sivua ei löytynyt" description="Etsimääsi sivua ei löytynyt.">
  <section class="fallback">
    <div class="wrap fallback-404">
      <p class="eyebrow">Virhe 404</p>
      <h1>Sivua ei löytynyt</h1>
      <p>Sivu on ehkä siirretty tai poistettu. Palaa etusivulle tai pyydä meiltä suoraan tarjous.</p>
      <div class="cta-row">
        <a class="btn btn-pine" href="/">Etusivulle</a>
        <a class="btn btn-outline-pine" href="/yhteystiedot/">Ota yhteyttä</a>
      </div>
    </div>
  </section>
</Layout>
