---
import Container from "@/components/container.astro";
import Cta from "@/components/cta.astro";
import Layout from "@/layouts/Layout.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

const values = [
  {
    title: "Kotimaisuus",
    icon: "bx:bxs-factory",
    description:
      "Myymme Skaalan Suomessa valmistamia ikkunoita ja ovia. Tuemme kotimaista työtä ja tarjoamme pohjoismaisiin olosuhteisiin suunniteltuja tuotteita.",
  },
  {
    title: "Asiantuntemus",
    icon: "bx:bxs-graduation",
    description:
      "Tunnemme ikkuna- ja ovituotteiden ominaisuudet läpikotaisin ja autamme valitsemaan juuri sinun kotiisi sopivan ratkaisun.",
  },
  {
    title: "Luotettavuus",
    icon: "bx:bxs-shield-alt-2",
    description:
      "Pidämme kiinni sovituista aikatauluista ja hoidamme projektin tarjouksesta asennukseen saakka läpinäkyvästi.",
  },
  {
    title: "Asiakaslähtöisyys",
    icon: "bx:bxs-heart",
    description:
      "Kuuntelemme asiakkaan toiveita ja tarpeita, jotta lopputulos palvelee arkea ja näyttää hyvältä vuosikymmenten ajan.",
  },
];
---

<Layout
  title="Yritys"
  description="Suomen Ikkuna & Ovi Oy on Skaala-tuotteiden jälleenmyyjä. Tutustu yritykseemme, arvoihimme ja tapaamme palvella asiakkaita kautta Suomen."
  schema={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Etusivu", item: new URL("/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: "Yritys", item: new URL("/yritys", Astro.site).toString() },
    ],
  }}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Yritys</Fragment>
      <Fragment slot="desc">
        Kotimaiset ikkunat ja ovet suomalaiseen kotiin – tutustu tarinaamme.
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-4 mx-auto max-w-3xl mt-16 text-lg leading-relaxed text-slate-600">
      <h2 class="font-bold text-3xl text-brand-950">
        Suomen Ikkuna &amp; Ovi Oy – Skaala-tuotteiden jälleenmyyjä
      </h2>
      <p>
        Suomen Ikkuna &amp; Ovi Oy on erikoistunut kotimaisten Skaala-ikkunoiden
        ja -ovien myyntiin ja asennukseen. Palvelemme sekä yksityistalouksia
        että rakennusliikkeitä uudisrakentamisen ja korjausrakentamisen
        hankkeissa kautta Suomen.
      </p>
      <p>
        Sloganimme <em>"Kotimaiset ikkunat ja ovet suomalaiseen kotiin"</em>
        kiteyttää toimintamme ytimen: tarjoamme laadukkaita, pohjoismaisiin
        olosuhteisiin suunniteltuja tuotteita yhdistettynä henkilökohtaiseen
        ja asiantuntevaan palveluun. Autamme asiakasta koko matkan
        alkukartoituksesta ja tuotevalinnasta aina asennukseen ja
        jälkihoitoon asti.
      </p>
      <p>
        Uskomme, että hyvät ikkunat ja ovet ovat investointi, joka näkyy
        kodin energiatehokkuudessa, viihtyvyydessä ja arvossa vuosikymmenten
        ajan. Siksi valitsemme yhteistyökumppaniksemme Skaalan, jonka
        tuotteet on suunniteltu ja valmistettu Suomessa kestämään pohjoinen
        ilmasto.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-8 mx-auto max-w-4xl mt-16">
      {
        values.map((item) => (
          <div class="flex gap-4 items-start">
            <div class="mt-1 bg-brand-900 rounded-full p-2.5 w-10 h-10 shrink-0 flex items-center justify-center">
              <Icon class="text-white w-5 h-5" name={item.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-lg text-brand-950">{item.title}</h3>
              <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="max-w-3xl mx-auto mt-16 bg-brand-50 rounded-xl p-8">
      <h2 class="font-bold text-2xl text-brand-950">Palvelualue</h2>
      <p class="mt-3 text-slate-600 leading-relaxed">
        Palvelemme asiakkaita kautta Suomen. Toimitamme ja asennamme
        Skaala-ikkunoita ja -ovia niin pääkaupunkiseudulla kuin muuallakin
        maassa – ota yhteyttä, niin kerromme tarkemmat aikataulut ja
        mahdollisuudet omalle alueellesi.
      </p>
    </div>

    <Cta />
  </Container>
</Layout>
