---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import Socials from "@/components/Socials.astro";
import { roles } from "@/data/content";
import { site } from "@/config/site";

const active = roles.filter((r) => r.active);
const past = roles.filter((r) => !r.active);
---

<Layout
  title="Politiikka"
  description="Sami Elmerannan poliittinen työ Kaarinassa ja Varsinais-Suomessa: kaupunginvaltuusto, kaupunginhallitus ja maakuntavaltuusto. Liike Nyt."
  breadcrumbs={[{ name: "Politiikka", path: "/politiikka/" }]}>
  <PageHero
    eyebrow="Sami & politiikka"
    title="Politiikkaa kunta- ja aluetasolla"
    lead="Poliittista vaikuttamista Kaarinassa ja Varsinais-Suomessa – vastuullisesti, avoimesti ja yhteistyöhakuisesti."
  />

  <section class="py-12" aria-labelledby="tausta-title">
    <Container class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div class="space-y-5 text-lg leading-relaxed text-muted" data-reveal="left">
        <h2 id="tausta-title" class="text-3xl font-bold text-ink">Vahvemmalla mandaatilla eteenpäin</h2>
        <p>
          Olen ollut mukana paikallispolitiikassa vuodesta 2021. Ensimmäisissä kuntavaaleissani tulin valituksi
          Kaarinan kaupunginvaltuustoon ja kaupunginhallitukseen. Vuoden 2025 vaaleissa luottamukseni vahvistui
          entisestään – äänimääräni kasvoi merkittävästi, ja jatkan nyt työtäni valtuustossa sekä kaupunginhallituksessa
          entistä vahvemmalla mandaatilla.
        </p>
        <p>
          Paikallisen päätöksenteon lisäksi olen ollut aktiivisesti mukana myös aluepolitiikassa jaostotasolla. Toimin
          tällä hetkellä Varsinais-Suomen maakuntavaltuuston jäsenenä, jossa pääsen vaikuttamaan laajemmin koko alueemme
          kehitykseen.
        </p>
      </div>
      <aside class="card self-start bg-mist" data-reveal="right">
        <p class="eyebrow">Puolue</p>
        <p class="mt-3 font-display text-3xl font-bold">{site.party.name}</p>
        <p class="mt-3 text-muted">
          Edustan Liike Nytiä Kaarinan ja Varsinais-Suomen päätöksenteossa.
        </p>
        <a href={site.party.url} target="_blank" rel="noopener noreferrer" class="btn-light mt-6">
          liikenyt.fi <Icon name="lucide:external-link" class="size-4" aria-hidden="true" />
        </a>
      </aside>
    </Container>
  </section>

  <section class="py-20" aria-labelledby="toimet-title">
    <Container>
      <SectionHead
        id="toimet-title"
        eyebrow="Luottamustoimet"
        title="Poliittiset luottamustoimeni"
        lead="Olen mukana paikallisessa ja alueellisessa päätöksenteossa – työtä paremman ja toimivamman Varsinais-Suomen puolesta."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          active.map((r, i) => (
            <article class="card overflow-hidden" data-reveal data-delay={String(i + 1)}>
              <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand to-brand-light" aria-hidden="true" />
              <p class="inline-flex items-center gap-2 text-sm font-semibold text-brand-dark">
                <span class="size-2 rounded-full bg-brand animate-pulse" aria-hidden="true" /> Nykyinen
              </p>
              <h3 class="mt-4 text-2xl font-bold leading-snug">{r.title}</h3>
              <p class="mt-3 text-muted">{r.text}</p>
            </article>
          ))
        }
      </div>

      <h3 class="mt-20 text-2xl font-bold" data-reveal>Aiemmat luottamustoimet</h3>
      <ol class="relative mt-8 space-y-6 border-l-2 border-line pl-8">
        {
          past.map((r, i) => (
            <li class="relative" data-reveal data-delay={String((i % 5) + 1)}>
              <span class="absolute -left-[2.55rem] top-1.5 size-4 rounded-full border-4 border-white bg-brand ring-2 ring-brand/30" aria-hidden="true" />
              <p class="font-display text-lg font-bold">{r.title}</p>
              <p class="text-muted">{r.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-14 max-w-2xl text-lg text-muted" data-reveal>
        Luottamustoimissa toimin arvojeni mukaisesti – vastuullisesti, avoimesti ja yhteistyöhakuisesti.
      </p>
    </Container>
  </section>

  <section class="py-12" aria-labelledby="keskustele-title">
    <Container class="grid gap-6 lg:grid-cols-2">
      <div class="card bg-ink text-white ring-0" data-reveal="left">
        <h2 id="keskustele-title" class="text-3xl font-bold">Haluatko keskustella politiikasta?</h2>
        <p class="mt-4 text-white/75">
          Olen täällä sinua varten – ilman turhaa byrokratiaa ja muodollisuuksia. Jos jokin asia mietityttää, haluat jakaa
          ajatuksia tai kysyä näkemyksiäni, ota rohkeasti yhteyttä. Matalalla kynnyksellä, avoimesti ja rakentavasti.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/yhteys/" class="btn-primary">Laita viestiä</a>
          <a href={`tel:${site.phone}`} class="btn-ghost">Soita {site.phoneDisplay}</a>
        </div>
      </div>
      <div class="card" data-reveal="right">
        <h2 class="text-3xl font-bold">Lue ajatuksiani</h2>
        <p class="mt-4 text-muted">
          Kirjoitan politiikasta omaan blogiini ja kirjoitan mielipidekirjoituksia eri lehtiin.
        </p>
        <ul class="mt-6 space-y-2">
          <li>
            <a href="/blogi/" class="inline-flex items-center gap-2 font-semibold text-brand-dark hover:underline">
              <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" /> Oma blogi
            </a>
          </li>
          {
            site.writing.map((w) => (
              <li>
                <a href={w.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-brand-dark hover:underline">
                  <Icon name="lucide:external-link" class="size-4" aria-hidden="true" /> {w.name}
                </a>
              </li>
            ))
          }
        </ul>
        <Socials class="mt-6" />
      </div>
    </Container>
  </section>

</Layout>
