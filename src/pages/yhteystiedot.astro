---
import Contactform from "@/components/contactform.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import yhteystiedotData from "@/data/yhteystiedot.json";

// Sisältö tulee src/data/yhteystiedot.json-tiedostosta, jota voi muokata
// paikallisesti Keystatic-editorilla (pnpm dev -> /keystatic) ilman koodia.
---

<Layout
  title="Yhteystiedot"
  description="Ota yhteyttä ja varaa maksuton alkukartoitus SEO-, AI-optimointi-, kotisivu- tai markkinointitarpeisiisi.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Yhteystiedot</Fragment>
      <Fragment slot="desc">Autan mielelläni – ota yhteyttä.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          Ota yhteyttä KasvuKumppaniin
        </h2>
        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          {yhteystiedotData.intro}
        </p>
        <div class="mt-5">
          <div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:map-marker" />
            <span>{yhteystiedotData.sijainti}</span>
          </div><div class="flex items-center mt-2 space-x-2 text-gray-600">
            <Icon class="text-gray-400 w-4 h-4" name="uil:envelope" /><a
              href={`mailto:${yhteystiedotData.email}`}
              >{yhteystiedotData.email}</a
            >
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
