---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import Testimonials from "@/components/Testimonials.astro";
import { career, workTestimonials } from "@/data/content";
---

<Layout
  title="Työelämä & yrittäjyys"
  description="Sami Elmerannan työura: aluemyyntijohtaja Sanoma Media Finlandilla, yrittäjä ja myynnin konsultti. Yli 17 vuotta myynnin johtotehtävissä."
  breadcrumbs={[{ name: "Työelämä & yrittäjyys", path: "/tyoelama/" }]}>
  <PageHero
    eyebrow="Työelämä & yrittäjyys"
    title="Monipuolinen työkokemus ja yrittäjyystausta antaa hyvät eväät politiikkaan"
    lead="Työurani alkoi ruokavaraston kassalta ja jatkui rautakaupan myyjänä, kokoonpanolinjalla ja ravintola-alalla. Nykyään johdan myyntiä ja toimin osakkaana sekä freelancerina."
  />

  <section class="pb-4" aria-label="Nosto">
    <Container class="max-w-4xl">
      <div class="relative flex items-center gap-4 overflow-hidden rounded-3xl bg-gradient-to-br from-brand via-liila to-ink-soft p-5 sm:gap-5 text-white shadow-xl sm:p-8" data-reveal="zoom">
        <div class="pointer-events-none absolute -right-10 -top-10 size-40 rounded-full bg-white/10 blur-2xl animate-blob" aria-hidden="true"></div>
        <span class="relative grid size-12 shrink-0 place-items-center rounded-2xl bg-white/15 sm:size-14"><Icon name="lucide:briefcase" class="size-7" aria-hidden="true" /></span>
        <p class="relative font-display text-xl font-bold leading-snug sm:text-3xl">Toimin tällä hetkellä osakkaana kolmessa mikroyrityksessä</p>
      </div>
    </Container>
  </section>

  <section class="py-12" aria-labelledby="ura-title">
    <Container class="max-w-4xl">
      <SectionHead id="ura-title" eyebrow="Työura" title="Kokemusta myynnistä, johtamisesta ja yrittämisestä" />
      <ol class="relative mt-14 space-y-10 before:absolute before:inset-y-2 before:left-[0.6rem] before:w-0.5 before:bg-gradient-to-b before:from-brand before:via-brand-light before:to-line sm:before:left-[9.6rem]">
        {
          career.map((c) => (
            <li class="relative grid gap-2 pl-10 sm:grid-cols-[8rem_1fr] sm:gap-10 sm:pl-0" data-reveal>
              <span class="absolute left-0 top-1.5 size-5 rounded-full border-4 border-white bg-brand shadow sm:left-[9rem]" aria-hidden="true" />
              <p class="text-sm font-semibold text-muted sm:pt-1 sm:text-right">{c.period}</p>
              <div class="sm:pl-10">
                <h3 class="text-xl font-bold">{c.title}</h3>
                <p class="font-semibold text-brand-dark">{c.org}</p>
                <p class="mt-2 text-muted">{c.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-14 rounded-3xl bg-mist p-6 text-lg text-muted" data-reveal>
        Edellä mainittujen lisäksi minulla on ollut useita osakasrooleja ja asiantuntijapositioita eri yrityksissä.
        Nykyään toimin osakkaana kolmessa mikroyrityksessä ja teen freelancerina erilaisia asiantuntijatöitä.
      </p>
    </Container>
  </section>

  <section class="bg-mist py-24" aria-labelledby="kollegat-title">
    <Container>
      <SectionHead id="kollegat-title" eyebrow="Suosittelut" title="Kollegoiden sanoin" />
      <div class="mt-12"><Testimonials items={workTestimonials} /></div>
    </Container>
  </section>
</Layout>
