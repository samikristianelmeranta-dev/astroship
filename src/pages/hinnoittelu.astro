---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";
import hinnoitteluData from "@/data/hinnoittelu.json";

// Sisältö tulee src/data/hinnoittelu.json-tiedostosta, jota voi muokata
// paikallisesti Keystatic-editorilla (pnpm dev -> /keystatic) ilman koodia.
const pricing = hinnoitteluData.paketit.map((paketti) => ({
  name: paketti.nimi,
  price: paketti.hinta,
  popular: paketti.suosituin,
  features: paketti.ominaisuudet,
  button: {
    text: paketti.nappiTeksti,
    link: "/yhteystiedot",
  },
}));
---

<Layout
  title="Hinnoittelu"
  description="Selkeät palvelupaketit SEO-optimointiin, AI-optimointiin, kotisivuihin ja digitaaliseen markkinointiin. Kysy räätälöity tarjous tarpeisiisi.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Hinnoittelu</Fragment>
      <Fragment slot="desc">
        Selkeät palvelupaketit kasvun eri vaiheisiin. Hinnat ovat suuntaa
        antavia – räätälöin aina tarjouksen yrityksesi tarpeiden mukaan.
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>

    <p class="text-center text-slate-500 mt-12">
      Epävarma, mikä paketti sopii sinulle? <a
        href="/yhteystiedot"
        class="text-emerald-600 font-medium hover:underline"
        >Varaa maksuton alkukartoitus</a
      >, niin katsotaan yhdessä.
    </p>
  </Container>
</Layout>
