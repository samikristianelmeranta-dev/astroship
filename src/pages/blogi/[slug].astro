---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PostCover from "@/components/postcover.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.snippet,
  datePublished: entry.data.publishDate.toISOString(),
  author: { "@type": "Organization", name: entry.data.author },
  publisher: { "@id": new URL("/#organization", Astro.site).toString() },
  mainEntityOfPage: new URL(`/blogi/${entry.slug}`, Astro.site).toString(),
};
---

<Layout title={entry.data.title} description={entry.data.snippet} schema={articleSchema}>
  <Container>
    <div class="mx-auto max-w-3xl mt-14">
      <span class="text-accent-600 uppercase tracking-wider text-sm font-medium">
        {entry.data.category}
      </span>
      <h1
        class="text-4xl lg:text-5xl font-bold text-brand-950 lg:tracking-tight mt-1 lg:leading-tight">
        {entry.data.title}
      </h1>
      <div class="flex gap-2 mt-3 items-center flex-wrap md:flex-nowrap">
        <span class="text-gray-400">
          {entry.data.author}
        </span>
        <span class="text-gray-400">•</span>
        <time
          class="text-gray-400"
          datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toLocaleDateString("fi-FI", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <span class="text-gray-400 hidden md:block">•</span>
        <div class="w-full md:w-auto flex flex-wrap gap-3">
          {
            entry.data.tags.map((tag) => (
              <span class="text-sm text-gray-500">#{tag}</span>
            ))
          }
        </div>
      </div>
      <PostCover icon={entry.data.icon} ratio="aspect-[21/9]" class="mt-8" />
    </div>

    <div class="mx-auto prose prose-lg mt-6 max-w-3xl prose-headings:text-brand-950 prose-a:text-accent-600">
      <Content />
    </div>
    <div class="text-center mt-8">
      <a
        href="/blogi"
        class="bg-brand-50 text-brand-800 px-5 py-3 rounded-md hover:bg-brand-100 transition"
        >← Takaisin blogiin</a
      >
    </div>
  </Container>
</Layout>
