---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Startti",
    price: "Ilmainen",
    popular: false,
    features: [
      "14 päivän ilmainen kokeilu",
      "1 mainoskampanja",
      "Peruskäyttäjätuki",
      "Analytiikka-dashboard",
      "Sähköpostituki",
      "TulosAgentti-brändi",
    ],
    button: {
      text: "Aloita ilmaiseksi",
      link: "/contact",
    },
  },
  {
    name: "Kasvu",
    price: {
      monthly: "490 €/kk",
      annual: "420 €/kk",
      discount: "15%",
      original: "590 €",
    },
    popular: true,
    features: [
      "Kaikki Startti-ominaisuudet",
      "Rajattomat kampanjat",
      "AI-optimointi reaaliajassa",
      "Konversio-optimointi",
      "Priorisoitu asiakastuki",
      "Kuukausiraportointi",
    ],
    button: {
      text: "Aloita nyt",
      link: "/contact",
    },
  },
  {
    name: "Yritys",
    price: "Räätälöity",
    popular: false,
    features: [
      "Kaikki Kasvu-ominaisuudet",
      "Oma tilivastaava",
      "Räätälöity strategia",
      "99,9 % palvelutaso (SLA)",
      "API-integraatiot",
      "24/7 puhelintuki",
    ],
    button: {
      text: "Ota yhteyttä",
      link: "/contact",
    },
  },
];
---

<Layout title="Hinnoittelu">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Hinnoittelu</Fragment>
      <Fragment slot="desc">
        Selkeää hinnoittelua ilman yllätyksiä. Maksat tuloksista.
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
