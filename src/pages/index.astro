---
import Layout from "@/layouts/TilihubLayout.astro";
import CtaBand from "@/components/site/CtaBand.astro";
import { site } from "@/data/site";
import { getPosts, formatDate } from "@/lib/posts";

const latest = (await getPosts()).slice(0, 4);

const services = [
  {
    title: "Kirjanpitopalvelut",
    text: "Luotettavaa ja selkeää kirjanpitoa, joka pitää yrityksesi talouden hallinnassa – ajallaan, ilman yllätyksiä. Automaatio antaa reaaliaikaisen näkymän kannattavuuteen ja kassavirtaan.",
    href: "/kirjanpitopalvelut/",
    tag: "Kuukausittain",
  },
  {
    title: "Tilinpäätöspalvelut",
    text: "Huolellisesti laadittu tilinpäätös antaa vahvan pohjan tulevaan. Varmistamme, että tilinpäätös täyttää lakisääteiset vaatimukset – ajallaan ja ammattitaidolla.",
    href: "/tilinpaatos/",
    tag: "Tilikauden lopussa",
  },
  {
    title: "Palkanlaskenta",
    text: "Täsmällinen palkanlaskenta takaa tyytyväiset työntekijät ja mielenrauhan työnantajalle. Hoidamme lakisääteiset velvoitteet oikein, ajallaan ja tietoturvallisesti.",
    href: "/palkanlaskenta/",
    tag: "Tulorekisteri",
  },
];

const reasons = [
  {
    title: "Aidosti tavoitettavissa",
    text: "Meidät saa kiinni puhelimella, sähköpostilla tai WhatsAppilla. Asiat hoituvat tutun ihmisen kautta ilman organisaatioviidakkoa.",
  },
  {
    title: "Konsultoiva tapa tehdä töitä",
    text: "Emme vain kirjaa lukuja – autamme, opastamme ja konsultoimme. Veroneuvonta ja liiketoimintakonsultointi kuuluvat yhteistyöhön.",
  },
  {
    title: "Täysin läpinäkyvä hinnoittelu",
    text: "Tiedät tarkalleen, mitä maksat ja mitä olemme tehneet. Ei piilokuluja, ei yllätyksiä laskussa.",
  },
  {
    title: "Digitaalinen ja reaaliaikainen",
    text: "Automaation ansiosta näet myynnin, kannattavuuden ja kassavirran milloin tahansa.",
  },
  {
    title: "Skaalautuu yrityksesi mukana",
    text: "Palvelu mukautuu tarpeisiin, olitpa aloittava yrittäjä tai vakiintunut toimija. Erikoistumme pk-yrityksiin.",
  },
  {
    title: "Asiakastyytyväisyys strategisena prioriteettina",
    text: "Asiakastyytyväisyys ei ole meille fraasi vaan strateginen painopiste. Asiakasarviot puhuvat puolestaan.",
  },
];

const steps = [
  { title: "Ilmainen kartoitus", text: "Käydään läpi yrityksesi tarpeet ja nykytilanne – ilman sitoumuksia." },
  { title: "Selkeä tarjous", text: "Saat läpinäkyvän tarjouksen, jossa ei ole piilokuluja." },
  { title: "Sujuva siirto", text: "Hoidamme siirron ja olemme tarvittaessa yhteydessä edelliseen tilitoimistoon." },
  { title: "Yhteistyö alkaa", text: "Sinulla on yksi tuttu yhteyshenkilö, joka tuntee yrityksesi alusta asti." },
];

const testimonials = [
  {
    quote:
      "TiliHub Oy:n kanssa yhteistyö on ollut helppoa ja mutkatonta. He tuntevat sote-alan käytännöt, joten hammasklinikkamme kirjanpito ja palkanlaskenta ovat sujuneet huoletta. Vahva suositus.",
    name: "Joel Mustonen",
    company: "Hammasklinikka Timantti",
  },
  {
    quote:
      "TiliHub on ollut meille hyvinvointialan koulutus- ja konsultaatiotyötä tekevälle uudelle yritykselle erinomainen kumppani. Asiantunteva verokonsultointi on tukenut päätöksentekoamme yrityksen alkutaipaleella.",
    name: "Iiro Jokipalo",
    company: "Open Mind Consulting",
  },
  {
    quote:
      "TiliHub Oy on meille juuri oikea kirjanpitotoimisto. Kirjanpitäjän saa kiinni ja puhelimessa on aina ihminen. Me olemme todella tyytyväisiä.",
    name: "Henri Haapakorva",
    company: "Mahti Kylpyhuoneet",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  name: site.name,
  description:
    "Moderni digitaalinen tilitoimisto Kaarinassa. Kirjanpito, palkanlaskenta ja tilinpäätöspalvelut pk-yrityksille Turussa ja koko Suomessa.",
  url: site.url,
  telephone: "+358440803344",
  email: site.email,
  address: { "@type": "PostalAddress", addressLocality: site.locality, addressRegion: site.region, addressCountry: "FI" },
  areaServed: ["Turku", "Kaarina", "Varsinais-Suomi", "Suomi"],
  serviceType: ["Kirjanpito", "Palkanlaskenta", "Tilinpäätös", "Taloushallinto"],
  sameAs: [site.facebook, site.instagram],
};
---

<Layout
  seoTitle="Tilitoimisto Turku & Varsinais-Suomi - Digitaalinen kirjanpito"
  description="Tilitoimisto TiliHub Oy on moderni digitaalinen tilitoimisto Kaarinasta. Tilitoimistopalvelut Turku & Varsinais-Suomi. Digitaalisesti ympäri Suomea. Kysy lisää!"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Digitaalinen tilitoimisto · Turku & Varsinais-Suomi</p>
        <h1>Tilitoimisto Turku & Varsinais-Suomi – <span>digitaalinen taloushallinnon kumppani</span></h1>
        <p class="lead">
          TiliHub Oy on yrittäjälähtöinen tilitoimisto Kaarinasta. Hoidamme kirjanpidon, palkanlaskennan ja
          tilinpäätökset pk-yrityksille selkeällä hinnoittelulla ilman piilokuluja – ja olemme aidosti
          tavoitettavissa. Palvelemme digitaalisesti koko Suomessa.
        </p>
        <div class="hero-actions">
          <a href="/yhteystiedot/" class="btn btn-primary">Pyydä tarjous</a>
          <a href="/kirjanpidon-hinnat/" class="btn btn-ghost">Katso hinnasto</a>
        </div>
        <dl class="hero-stats">
          <div><dt>Asiakasarvioiden keskiarvo</dt><dd>5★</dd></div>
          <div><dt>Perustettu</dt><dd>2025</dd></div>
          <div><dt>Digitaalinen</dt><dd>100 %</dd></div>
        </dl>
      </div>

      <figure class="report" aria-label="Havainnekuva kuukausiraportista">
        <div class="report-head">
          <div>
            <p class="report-label">Kuukausiraportti</p>
            <p class="report-title">Asiakasyritys Oy · syyskuu</p>
          </div>
          <span class="badge">Täsmäytetty</span>
        </div>
        <dl class="ledger tnum">
          <div><dt>Liikevaihto</dt><dd>24 860,00 €</dd></div>
          <div><dt>Materiaalit ja palvelut</dt><dd>−6 412,40 €</dd></div>
          <div><dt>Henkilöstökulut</dt><dd>−9 730,15 €</dd></div>
          <div><dt>Muut kulut</dt><dd>−2 118,90 €</dd></div>
          <div class="total"><dt>Tulos</dt><dd>6 598,55 €</dd></div>
        </dl>
        <div class="bars" aria-hidden="true">
          {[42, 55, 48, 61, 58, 70, 66, 74, 82].map((h, i) => <span style={`--h:${h}%`} class={i === 8 ? "now" : ""} />)}
        </div>
        <p class="bars-caption">Liikevaihto tammi–syys</p>
        <div class="deadlines">
          <p class="report-label">Eräpäivät</p>
          <ul class="tnum">
            <li><time>12.10.</time> ALV-ilmoitus ja maksu <span>Hoidettu</span></li>
            <li><time>12.10.</time> Työnantajasuoritukset <span>Hoidettu</span></li>
            <li class="open"><time>20.10.</time> TyEL-maksu <span>Muistutettu</span></li>
          </ul>
        </div>
        <figcaption>Esimerkki</figcaption>
      </figure>
    </div>
  </section>

  <section class="strip" aria-label="Ohjelmistot ja jäsenyys">
    <div class="wrap strip-inner">
      <p>Käytämme nykyaikaisia ohjelmistoja</p>
      <ul>{site.software.map((s) => <li>{s}</li>)}</ul>
      <p class="strip-member">Taloushallintoliiton jäsen</p>
    </div>
  </section>

  <main>
    <!-- Palvelut -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Palvelut</p>
          <h2>Kaikki tilitoimiston palvelut saman katon alta</h2>
          <p>
            Me huolehdimme numeroistasi, jotta sinä voit keskittyä yrityksen kasvattamiseen Turun alueella tai
            digitaalisesti ympäri Suomea. Olemme aito kumppani – enemmän kuin perinteinen tilitoimisto.
          </p>
        </div>
        <ul class="services">
          {
            services.map((s) => (
              <li>
                <a href={s.href}>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                  <span class="service-foot">
                    <span class="tag">{s.tag}</span>
                    <span class="more">Lue lisää →</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Miksi -->
    <section class="section section-alt">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Miksi TiliHub?</p>
          <h2>Tilitoimisto, joka auttaa aidosti yrittäjän arkea</h2>
          <p>
            Läpinäkyvä hinnoittelu, konsultoiva ote ja aito kiinnostus yrityksesi menestykseen – siksi kasvava
            joukko pk-yrittäjiä luottaa TiliHubiin.
          </p>
        </div>
        <dl class="reasons">
          {
            reasons.map((r) => (
              <div>
                <dt>{r.title}</dt>
                <dd>{r.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Vaihto -->
    <section class="section">
      <div class="wrap steps-grid">
        <div class="section-head">
          <p class="eyebrow">Tilitoimiston vaihto</p>
          <h2>Oletko vaihtamassa tilitoimistoa?</h2>
          <p>
            Vaihto on helpompi kuin usein luullaan. Käymme yrityksesi tilanteen, tarpeet ja nykyisen
            taloushallintoratkaisun läpi yhdessä. Vaihdos ei aiheuta katkoksia – tarvittaessa hoidamme kaiken
            puolestasi.
          </p>
          <a href="/tilitoimistoa-vaihtamassa/" class="text-link">Lue lisää tilitoimiston vaihdosta →</a>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="step-no tnum">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Asiakaskokemukset -->
    <section class="section section-alt">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Asiakaskokemukset</p>
          <h2>Mitä asiakkaat meistä sanovat?</h2>
        </div>
        <div class="quotes">
          {
            testimonials.map((t) => (
              <figure>
                <blockquote>”{t.quote}”</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{t.company}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Paikallinen -->
    <section class="section">
      <div class="wrap local-grid">
        <div class="local-text">
          <p class="eyebrow">Tilitoimisto Turku & Varsinais-Suomi</p>
          <h2>Paikallinen tilitoimisto Turun talousalueella</h2>
          <p>
            Etsitkö tilitoimistoa Turusta tai lähialueilta? TiliHub Oy on kaarinalainen tilitoimisto, joka palvelee
            pk-yrityksiä koko Varsinais-Suomessa – ja digitaalisesti koko Suomessa.
          </p>
          <p>
            Paikallisuus tarkoittaa meille nopeaa palvelua, henkilökohtaista yhteydenpitoa ja ymmärrystä alueen
            yritystoiminnan erityispiirteistä. Ymmärrämme yrittäjän arjen ja tarjoamme ratkaisuja, jotka tukevat
            kasvua ja kannattavuutta – olitpa juuri aloittanut tai jo vakiintunut toimija.
          </p>
          <ul class="chips area-chips">{site.areas.map((a) => <li><span>{a}</span></li>)}</ul>
        </div>
        <aside class="contact-card">
          <h3>Ota yhteyttä – vastaamme nopeasti</h3>
          <dl>
            <div><dt>Puhelin</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
            <div><dt>Sähköposti</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>WhatsApp</dt><dd><a href={site.whatsapp} rel="noopener">Lähetä viesti</a></dd></div>
            <div><dt>Toimialue</dt><dd>{site.area}</dd></div>
          </dl>
          <a href="/yhteystiedot/" class="btn btn-primary">Jätä yhteydenottopyyntö</a>
        </aside>
      </div>
    </section>

    <!-- Uusimmat artikkelit -->
    <section class="section section-alt">
      <div class="wrap">
        <div class="section-head head-row">
          <div>
            <p class="eyebrow">Artikkelit</p>
            <h2>Ajankohtaista kirjanpidosta</h2>
          </div>
          <a href="/blogi/" class="text-link">Kaikki artikkelit →</a>
        </div>
        <ul class="post-list latest">
          {
            latest.map((p) => (
              <li>
                <a href={p.data.path}>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <div>
                    <h3>{p.data.title}</h3>
                    {p.data.description && <p>{p.data.description}</p>}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <CtaBand />
</Layout>

<style>
  /* Hero */
  .hero {
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    /* ruutupaperin hento ristikko */
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .hero-eyebrow {
    color: var(--hero-accent);
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    font-weight: 800;
    margin-top: 1rem;
  }
  .hero h1 span {
    color: var(--hero-accent);
  }
  .lead {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    color: var(--hero-muted);
    max-width: 36rem;
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero .btn-ghost {
    color: var(--hero-ink);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2.5rem 0 0;
  }
  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero-stats dt {
    font-size: var(--step--1);
    color: var(--hero-muted);
  }
  .hero-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    color: var(--hero-ink);
  }

  /* Raporttikortti (havainnekuva, sama ilme molemmissa teemoissa) */
  .report {
    margin: 0;
    background: #fbfcfb;
    color: #0f2420;
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.55);
    position: relative;
    animation: rise 0.7s ease-out both;
  }
  @keyframes rise {
    from {
      transform: translateY(12px);
    }
    to {
      transform: none;
    }
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }
  .report-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b7c75;
  }
  .report-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    margin-top: 0.2rem;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: #e2efe9;
    color: #0b6e55;
    padding: 0.25rem 0.6rem;
    border-radius: 99px;
    white-space: nowrap;
  }
  .ledger {
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .ledger div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed #d9e0dc;
  }
  .ledger dt {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: #3d4f48;
  }
  .ledger dd {
    margin: 0;
    white-space: nowrap;
  }
  .ledger .total {
    border-bottom: 3px double #0f2420;
    font-weight: 500;
  }
  .ledger .total dt {
    font-weight: 600;
    color: #0f2420;
  }
  .ledger .total dd {
    color: #0b6e55;
  }
  .bars {
    display: flex;
    align-items: end;
    gap: 6px;
    height: 70px;
    margin-top: 1.25rem;
  }
  .bars span {
    flex: 1;
    height: var(--h);
    background: #cfe2da;
    border-radius: 2px 2px 0 0;
  }
  .bars .now {
    background: #0b6e55;
  }
  .bars-caption {
    font-size: 0.75rem;
    color: #6b7c75;
    margin-top: 0.35rem;
  }
  .deadlines {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid #d9e0dc;
  }
  .deadlines ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
  }
  .deadlines li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .deadlines time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    min-width: 3.2rem;
  }
  .deadlines li span {
    margin-left: auto;
    font-size: 0.75rem;
    color: #0b6e55;
    font-weight: 600;
  }
  .deadlines li.open span {
    color: #b8641a;
  }
  .report figcaption {
    position: absolute;
    top: -0.7rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #b8641a;
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  /* Ohjelmistot */
  .strip {
    border-bottom: 1px solid var(--line);
  }
  .strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2.5rem;
    padding-block: 1.5rem;
  }
  .strip p {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .strip-member {
    margin-left: auto;
  }

  /* Osiot */
  .section-alt {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .section-head {
    max-width: 42rem;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .section-head h2 {
    font-size: var(--step-3);
    font-weight: 700;
  }
  .section-head p:not(.eyebrow) {
    color: var(--muted);
  }
  .head-row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  .head-row > div {
    display: grid;
    gap: 0.9rem;
  }
  .text-link {
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }

  .services {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
  .services a {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .services a:hover {
    border-color: var(--accent);
  }
  .services h3 {
    font-size: var(--step-1);
  }
  .services p {
    color: var(--muted);
  }
  .service-foot {
    margin-top: auto;
