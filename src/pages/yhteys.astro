---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import PageHero from "@/components/PageHero.astro";
import Socials from "@/components/Socials.astro";
import Newsletter from "@/components/Newsletter.astro";
import { site } from "@/config/site";

const channels = [
  { icon: "lucide:phone", title: "Soita", value: site.phoneDisplay, href: `tel:${site.phone}`, external: false },
  { icon: "simple-icons:whatsapp", title: "WhatsApp", value: "Laita viestiä", href: site.whatsapp, external: true },
  { icon: "lucide:mail", title: "Sähköposti", value: site.email, href: `mailto:${site.email}`, external: false },
];

const input =
  "mt-2 block w-full rounded-2xl border-0 bg-mist px-4 py-3.5 ring-1 ring-line transition placeholder:text-muted/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand";
---

<Layout
  title="Ota yhteyttä"
  description="Ota yhteyttä Sami Elmerantaan: puhelin 050 346 0444, WhatsApp, sähköposti tai yhteydenottolomake. Kaikki yhteydenotot ovat tervetulleita."
  breadcrumbs={[{ name: "Ota yhteyttä", path: "/yhteys/" }]}
  schema={[{ "@type": "ContactPage", name: "Ota yhteyttä", about: { "@id": `${site.url}/#person` } }]}>
  <PageHero
    eyebrow="Ota yhteyttä"
    title="Jotain mielessä?"
    lead="Älä epäröi olla yhteydessä – kuulen mielelläni ajatuksiasi ja palautettasi. Politiikka on yhteistyötä, ja jokainen näkökulma on tärkeä."
  />

  <section class="py-8">
    <Container class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="space-y-4">
        {
          channels.map((c, i) => (
            <a
              href={c.href}
              {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="card group flex items-center gap-5"
              data-reveal="left"
              data-delay={String(i + 1)}>
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-brand text-white transition duration-500 group-hover:rotate-6 group-hover:scale-110">
                <Icon name={c.icon} class="size-6" aria-hidden="true" />
              </span>
              <span>
                <span class="block text-sm font-semibold uppercase tracking-wider text-muted">{c.title}</span>
                <span class="block break-all font-display text-xl font-bold">{c.value}</span>
              </span>
              <Icon name="lucide:arrow-up-right" class="ml-auto size-5 text-brand opacity-0 transition group-hover:opacity-100" aria-hidden="true" />
            </a>
          ))
        }
        <div class="card" data-reveal="left" data-delay="4">
          <p class="font-semibold">Seuraa minua somessa</p>
          <Socials class="mt-3" />
        </div>
      </div>

      <div class="card !p-8 sm:!p-10" data-reveal="right">
        <h2 class="text-3xl font-bold">Lähetä viesti</h2>
        {
          site.formEndpoint ? (
            <form action={site.formEndpoint} method="POST" class="mt-8 grid gap-5 sm:grid-cols-2" accept-charset="UTF-8">
              <label class="font-medium">
                Etunimi
                <input name="etunimi" required maxlength="80" autocomplete="given-name" class={input} />
              </label>
              <label class="font-medium">
                Sukunimi
                <input name="sukunimi" required maxlength="80" autocomplete="family-name" class={input} />
              </label>
              <label class="font-medium sm:col-span-2">
                Sähköposti
                <input type="email" name="email" required maxlength="160" autocomplete="email" class={input} />
              </label>
              <label class="font-medium sm:col-span-2">
                Viestisi
                <textarea name="viesti" required rows="6" minlength="10" maxlength="5000" class={input} />
              </label>
              {/* Roskapostiansa: ihmiset eivät näe tätä kenttää */}
              <div class="hidden" aria-hidden="true">
                <label>
                  Älä täytä tätä
                  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <p class="text-sm text-muted sm:col-span-2">
                Lähettämällä viestin hyväksyt, että tietojasi käsitellään yhteydenottoon vastaamiseksi.
                <a href="/tietosuoja/" class="font-semibold text-brand-dark underline">Tietosuojaseloste</a>
              </p>
              <button type="submit" class="btn-primary sm:col-span-2 sm:justify-self-start">
                Lähetä <Icon name="lucide:send" class="size-4" aria-hidden="true" />
              </button>
            </form>
          ) : (
            <div class="mt-6 space-y-5 text-lg text-muted">
              <p>
                Voit laittaa viestiä, soittaa tai ehdottaa tapaamista – kaikki yhteydenotot ovat tervetulleita. Yhdessä
                voimme pohtia ratkaisuja ja vaihtaa ajatuksia paremmasta tulevaisuudesta.
              </p>
              <a href={`mailto:${site.email}?subject=${encodeURIComponent("Yhteydenotto sivustolta")}`} class="btn-primary">
                Kirjoita sähköposti <Icon name="lucide:send" class="size-4" aria-hidden="true" />
              </a>
            </div>
          )
        }
      </div>
    </Container>
  </section>

  <Newsletter />
</Layout>
