---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Button from "@/components/ui/button.astro";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Näkyvyystesti">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Hakukone- ja AI-näkyvyystesti</Fragment>
      <Fragment slot="desc">
        Syötä yrityksesi verkko-osoite. Saat sähköpostiisi maksuttoman
        raportin siitä, miten hyvin sivustosi näkyy Googlessa ja
        tekoälyavustajissa kuten ChatGPT, Claude ja Perplexity.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-xl mt-12">
      <div class="grid sm:grid-cols-3 gap-4 mb-10 text-center">
        <div class="p-4 rounded-lg bg-slate-50">
          <Icon class="w-6 h-6 mx-auto text-slate-500" name="uil:search" />
          <p class="text-sm mt-2 text-slate-600">1. Syötä osoite</p>
        </div>
        <div class="p-4 rounded-lg bg-slate-50">
          <Icon class="w-6 h-6 mx-auto text-slate-500" name="uil:robot" />
          <p class="text-sm mt-2 text-slate-600">2. Analysoimme sivuston</p>
        </div>
        <div class="p-4 rounded-lg bg-slate-50">
          <Icon class="w-6 h-6 mx-auto text-slate-500" name="uil:envelope" />
          <p class="text-sm mt-2 text-slate-600">3. Raportti sähköpostiin ~4h</p>
        </div>
      </div>

      <form id="visibility-form" class="needs-validation" novalidate>
        <input
          type="text"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />
        <div class="mb-5">
          <label for="url" class="block text-sm font-medium text-gray-700 mb-1"
            >Verkko-osoite</label
          >
          <input
            id="url"
            name="url"
            type="text"
            required
            placeholder="esim. omayritys.fi"
            class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
          />
        </div>
        <div class="mb-5">
          <label
            for="email"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Sähköpostiosoite</label
          >
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="sinä@yritys.fi"
            class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
          />
        </div>
        <div class="mb-5">
          <label
            for="company"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Yrityksen nimi (valinnainen)</label
          >
          <input
            id="company"
            name="company"
            type="text"
            placeholder="Oma Yritys Oy"
            class="w-full px-4 py-3 border-2 placeholder:text-gray-400 rounded-md outline-hidden focus:ring-4 border-gray-300 focus:border-gray-600 ring-gray-100"
          />
        </div>

        <Button type="submit" size="lg" block id="submit-btn">
          Testaa näkyvyys ilmaiseksi
        </Button>

        <p class="text-xs text-slate-400 mt-3 text-center">
          Lähettämällä lomakkeen hyväksyt, että olemme sinuun yhteydessä
          tulosten tiimoilta.
        </p>

        <div id="form-result" class="mt-4 text-center text-sm"></div>
      </form>
    </div>
  </Container>
</Layout>

<script is:inline>
  const form = document.getElementById("visibility-form");
  const result = document.getElementById("form-result");
  const submitBtn = document.getElementById("submit-btn");

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    form.classList.add("was-validated");
    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid")[0]?.focus();
      return;
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData);

    submitBtn.setAttribute("disabled", "true");
    submitBtn.style.opacity = "0.6";
    result.className = "mt-4 text-center text-sm text-slate-500";
    result.innerHTML = "Analysoidaan sivustoasi, hetki...";

    try {
      const res = await fetch("/api/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || "Jokin meni pieleen.");
      }

      result.className = "mt-4 text-center text-sm text-green-600 font-medium";
      result.innerHTML = `Kiitos! Alustava tulos - Hakukonenäkyvyys: ${data.seoScore}/100, AI-näkyvyys: ${data.aiScore}/100. Täysi raportti saapuu sähköpostiisi noin 4 tunnin kuluessa.`;
      form.reset();
      form.classList.remove("was-validated");
    } catch (err) {
      result.className = "mt-4 text-center text-sm text-red-600 font-medium";
      result.innerHTML = err.message || "Jokin meni pieleen. Yritä uudelleen.";
    } finally {
      submitBtn.removeAttribute("disabled");
      submitBtn.style.opacity = "1";
    }
  });
</script>
